{
  "name": "vantage",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter mobile start",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.0.0",
    "typescript": "~5.9.2"
  }
}
